# Database
MONGODB_URI=

# Auth
JWT_SECRET=

# Password reset email (optional — logs token to console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MediVoice <noreply@medivoice.local>
RESET_PASSWORD_URL_BASE=medivoice://reset-password

# Gemini Chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=30000
CHAT_MAX_HISTORY_MESSAGES=20

# Voice - Local Whisper STT
WHISPER_SERVICE_URL=http://127.0.0.1:8001
WHISPER_TIMEOUT_MS=60000
WHISPER_MODEL_SIZE=small

# Voice - Local Piper TTS
PIPER_EXECUTABLE=/path/to/piper
PIPER_MODEL=/path/to/model.onnx
PIPER_CONFIG=/path/to/model.onnx.json
PIPER_TIMEOUT_MS=30000

# Medicine Scanner
MEDICINE_DATABASE_TIMEOUT_MS=15000
OPENFDA_BASE_URL=https://api.fda.gov
OPENFDA_API_KEY=
